{
  "_comment": "PIweb Configuration — copy this file to piweb.config.json and edit",

  "_example_deepseek": {
    "preset": "deepseek",
    "provider": "openai",
    "baseURL": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "maxTokens": 8192
  },

  "_example_ollama": {
    "preset": "ollama",
    "provider": "openai",
    "baseURL": "http://localhost:11434/v1",
    "model": "llama3.3",
    "maxTokens": 4096
  },

  "_example_anthropic": {
    "preset": "anthropic",
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "maxTokens": 8192
  },

  "_example_openai": {
    "preset": "openai",
    "provider": "openai",
    "baseURL": "https://api.openai.com/v1",
    "model": "gpt-4o",
    "maxTokens": 8192
  },

  "_example_walnutpi_playwright_mcp": {
    "playwright": {
      "command": "/usr/bin/npx",
      "args": ["-y", "@playwright/mcp@latest", "--executable-path", "/usr/bin/chromium"],
      "env": {
        "DISPLAY": ":0",
        "HOME": "/home/pi",
        "XDG_RUNTIME_DIR": "/run/user/1000"
      },
      "enabled": true
    }
  },

  "provider": "openai",
  "baseURL": "https://api.deepseek.com/v1",
  "model": "deepseek-chat",
  "maxTokens": 8192,
  "gptThinking": false,
  "frontendAuthRequired": false,
  "mcp": {
    "playwright": {
      "command": "/usr/bin/npx",
      "args": ["-y", "@playwright/mcp@latest", "--executable-path", "/usr/bin/chromium"],
      "env": {
        "DISPLAY": ":0",
        "HOME": "/home/pi",
        "XDG_RUNTIME_DIR": "/run/user/1000"
      },
      "enabled": true
    }
  }
}

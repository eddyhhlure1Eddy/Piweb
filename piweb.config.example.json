{
  "_comment": "PIweb Configuration — copy this file to piweb.config.json and edit",

  "_example_funnypi": {
    "preset": "funnypi",
    "provider": "openai",
    "baseURL": "https://funnypi.com/proxy/v1",
    "scheduler": {
      "enabled": true,
      "plan": "a"
    }
  },

  "_example_deepseek": {
    "preset": "deepseek",
    "provider": "openai",
    "baseURL": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "maxTokens": 8192
  },

  "_example_ollama": {
    "preset": "ollama",
    "provider": "openai",
    "baseURL": "http://localhost:11434/v1",
    "model": "llama3.3",
    "maxTokens": 4096
  },

  "_example_anthropic": {
    "preset": "anthropic",
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "maxTokens": 8192
  },

  "_example_openai": {
    "preset": "openai",
    "provider": "openai",
    "baseURL": "https://api.openai.com/v1",
    "model": "gpt-4o",
    "maxTokens": 8192
  },

  "provider": "openai",
  "baseURL": "https://api.deepseek.com/v1",
  "model": "deepseek-chat",
  "maxTokens": 8192,
  "mcp": {},

  "_example_reflect_endpoint": {
    "scheduler": {
      "reflectEndpoint": {
        "enabled": true,
        "provider": "openai",
        "baseURL": "https://your-reflect-provider.com/v1",
        "apiKey": "your-reflect-api-key",
        "model": "strong-model-name"
      }
    }
  }
}

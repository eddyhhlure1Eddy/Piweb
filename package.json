{
  "name": "piweb",
  "version": "2.1.0",
  "type": "module",
  "bin": {
    "piweb": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "cli": "node dist/index.js --cli",
    "daemon": "node dist/index.js --daemon",
    "relay": "node dist/index.js --relay"
  },
  "files": [
    "dist/",
    "public/",
    "docs/.gitkeep",
    "icon/",
    "scripts/",
    "skills/.gitkeep",
    "tools/",
    "!tools/aivdb/**/*.exe",
    "!tools/aivdb/dist/**/*.py",
    "!tools/aivdb/**/__pycache__/**",
    "!tools/aivdb/**/*.pyc",
    "!tools/aivdb/**/*.pyo",
    ".env.example",
    "CHANGELOG.md",
    "README.md",
    "piweb.config.example.json",
    "piweb-daemon.cmd",
    "reset-token.cmd",
    "start.cmd",
    "start.ps1",
    "start.sh"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@biomejs/biome": "2.4.16",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@playwright/test": "^1.58.2",
    "@prisma/language-server": "31.9.0",
    "@vue/language-server": "3.2.7",
    "bash-language-server": "5.6.0",
    "croner": "^10.0.1",
    "dockerfile-language-server-nodejs": "0.15.0",
    "intelephense": "1.18.4",
    "prettier": "3.8.3",
    "pyright": "1.1.409",
    "typescript-language-server": "5.1.3",
    "vscode-jsonrpc": "8.2.1",
    "vscode-langservers-extracted": "4.10.0",
    "vscode-languageserver-types": "3.17.5",
    "ws": "^8.18.1",
    "yaml-language-server": "1.22.0"
  },
  "overrides": {
    "bash-language-server": {
      "editorconfig": {
        "minimatch": "10.2.5"
      }
    }
  }
}

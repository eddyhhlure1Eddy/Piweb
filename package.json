    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.68",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
